NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=https://your-production-domain.example

# Manual link sharing needs no SMTP or SMS provider credentials.
# Email invitations still use SUPABASE_SECRET_KEY and configured Supabase SMTP.

# Server-only opt-in; affects only newly generated links explicitly marked for the pilot.
PATIENT_INVITE_LINK_ONLY_ENABLED=false
